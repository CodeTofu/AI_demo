# 复制此文件为 .env 并填写实际值
#
# 模型路由（可选）：google | gemini | openai | deepseek
# 不设 AI_PROVIDER 时自动选：OPENAI_API_KEY → DEEPSEEK_API_KEY → DASHSCOPE_API_KEY（纯文本默认 qwen-turbo）→ Gemini Key（国内慎用易超时）
# AI_PROVIDER=google

# ----- 阿里云百炼 DashScope（OpenAI 兼容，推荐用于聊天「上传图片」）-----
# https://dashscope.console.aliyun.com/
# DASHSCOPE_API_KEY=sk-xxx
# DASHSCOPE_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_VL_MODEL=qwen-vl-plus
# 纯文本对话在未配置 DeepSeek 且配置了百炼时可用（默认 qwen-turbo，百炼控制台可查可用模型名）
# DASHSCOPE_CHAT_MODEL=qwen-turbo
# 聊天中凡含用户图片均走 DASHSCOPE_VL_MODEL（与 Gemini 无关）

# ----- RAG 向量化（复用 DASHSCOPE_API_KEY，模型与聊天不同）-----
# EMBEDDING_PROVIDER=dashscope
# EMBEDDING_MODEL=text-embedding-v3
# EMBEDDING_DIMENSIONS=1024

# ----- RAG 接入 /api/chat（需先 ingest 知识库）-----
# RAG_ENABLED=true
# RAG_TOP_K=3
# RAG_MIN_SCORE=0.25
# RAG_CHUNK_SIZE=500
# RAG_CHUNK_OVERLAP=80

# ----- Google Gemini（AI Studio / Generative Language API）-----
# https://aistudio.google.com/apikey
# GOOGLE_GENERATIVE_AI_API_KEY=your-google-ai-api-key
# 或与 SDK 文档一致的别名：
# GEMINI_API_KEY=your-google-ai-api-key
# GEMINI_MODEL=gemini-1.5-flash
# 若出现 Connect Timeout：多为本机连不上 Google。可先启动本地 HTTP 代理再配置（与 Clash / v2rayN 里「HTTP 端口」一致，未开代理会 ECONNREFUSED）：
# HTTPS_PROXY=http://127.0.0.1:7890
# 如有自建反代，可改官方 API 前缀（一般不需要）：
# GOOGLE_GENERATIVE_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ----- OpenAI -----
# OPENAI_API_KEY=sk-xxx
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# 多模态（聊天页上传图片）：一律 DashScope 千问视觉（必须配置 DASHSCOPE_API_KEY）。纯文本仍按 AI_PROVIDER / Key 优先级。

# ----- DeepSeek（兼容 OpenAI 格式）-----
# DEEPSEEK_API_KEY=sk-xxx
# DEEPSEEK_API_BASE=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat
# 使用 deepseek-v4-pro 等「思考模式」时，工具多轮若报错 reasoning_content：后端已默认在请求中关闭 thinking；
# 若要显式开启思考链（可能与工具调用冲突）：DEEPSEEK_THINKING_MODE=enabled

# JWT 密钥（与 auth 模块一致即可）
# JWT_SECRET=your-secret-key-change-in-production
